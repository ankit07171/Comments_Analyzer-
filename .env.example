# ============================================================
#  Comment Intelligence Platform — environment configuration
#  Copy this file to ".env" and fill in your real values.
#  Nothing here is required to explore the UI with sample data,
#  but ingestion + alerting features need the relevant keys.
# ============================================================

# ---------------- INGESTION: YOUTUBE ----------------
YOUTUBE_API_KEY=your_youtube_data_api_key

# ---------------- INGESTION: INSTAGRAM (via Apify) ----------------
APIFY_TOKEN=your_apify_token

# ---------------- INGESTION: BLUESKY (AT Protocol) ----------------
BLUESKY_HANDLE=your-handle.bsky.social
BLUESKY_PASSWORD=your_app_password

# ---------------- AI SUMMARY / DEEP EXPLANATIONS (optional) ----------------
# Powers the natural-language "why was this flagged" explanations for
# critical/negative comments, and the AI post summary. Safe to leave blank —
# the analyzer falls back to the built-in rule-based explanation engine.
GEMINI_API_KEY=your_gemini_api_key

# ---------------- ALERTING: JIRA CLOUD ----------------
# Used to auto-create tickets for high-priority / negative comments.
JIRA_DOMAIN=your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=CS
JIRA_ISSUE_TYPE=Task

# ---------------- CACHING / DEDUPE: UPSTASH REDIS ----------------
# Free serverless Redis (REST API, no Docker/server required).
# Used for alert de-duplication, rolling stats, and rate limiting.
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# ---------------- APP SETTINGS ----------------
# Minimum priority level that triggers a Jira ticket + in-app alert.
# One of: Low, Medium, High, Critical
ALERT_PRIORITY_THRESHOLD=High

# Hours before the same negative comment can trigger another Jira ticket.
ALERT_DEDUPE_TTL_HOURS=24

LOG_LEVEL=INFO
